# Keep the build context small. The Dockerfile installs from the checked-out
# source tree so container publication does not race PyPI availability.
.git/
.github/
# The two hashed locks the builder stage installs from. Everything else under
# .github/ stays out of the context; these are the only files the image needs.
!.github/requirements/pip.txt
!.github/requirements/runtime-all.txt
.gitignore
.venv/
.pytest_cache/
.tmp-validation/
.tmp/
.ruff_cache/
.mypy_cache/
__pycache__/
*.pyc
*.pyo
dist/
build/
*.egg-info/
melhorias/
# Assistant instruction files are local operating context. They are gitignored, so
# they never reach a clone — but a maintainer building from a working tree would
# otherwise pull them into the build context.
CLAUDE.md
AGENTS.md
GEMINI.md
.cursorrules
.aider*
out/
tests/
docs/
examples/
gitpage/
pipelines/
reports/
waivers/
scripts/
CHANGELOG.md
SECURITY.md
