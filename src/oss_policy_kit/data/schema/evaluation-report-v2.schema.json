{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/schema/evaluation-report-v2.schema.json",
  "title": "OSS Policy Kit evaluation report (reports/0.2)",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "kit_version",
    "target_path",
    "profile_id",
    "profile_title",
    "summary_by_status",
    "results",
    "operational_warnings",
    "scorecard_path",
    "scorecard_supplemental",
    "external_waiver_path",
    "action_insights",
    "live_collection"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": ".*/reports/0\\.2$"
    },
    "generated_at": { "type": "string" },
    "kit_version": { "type": "string" },
    "target_path": { "type": "string" },
    "profile_id": { "type": "string" },
    "profile_title": { "type": "string" },
    "summary_by_status": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "operational_warnings": { "type": "array", "items": { "type": "string" } },
    "scorecard_path": { "type": ["string", "null"] },
    "scorecard_supplemental": {},
    "external_waiver_path": { "type": ["string", "null"] },
    "action_insights": { "type": "object" },
    "live_collection": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["performed", "platform", "collected_at", "api_evidence_sources"],
          "additionalProperties": true,
          "properties": {
            "performed": { "type": "boolean" },
            "platform": { "type": ["string", "null"] },
            "collected_at": { "type": ["string", "null"] },
            "api_evidence_sources": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "title",
          "category",
          "status",
          "lifecycle",
          "profile",
          "evidence_sources",
          "confidence",
          "reason",
          "remediation",
          "owner",
          "expires_at",
          "extra",
          "waiver",
          "evidence_collection_method"
        ],
        "additionalProperties": true,
        "properties": {
          "control_id": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "status": { "type": "string" },
          "lifecycle": { "type": "string" },
          "profile": { "type": "string" },
          "evidence_sources": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string" },
          "reason": { "type": "string" },
          "remediation": { "type": "string" },
          "owner": {},
          "expires_at": {},
          "extra": { "type": "object" },
          "waiver": {},
          "evidence_collection_method": { "type": "string" },
          "assurance": {
            "type": "string",
            "enum": ["deterministic", "signal", "evidence-backed"]
          },
          "deprecation_note": { "type": "string" }
        }
      }
    }
  }
}
