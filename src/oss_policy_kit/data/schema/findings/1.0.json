{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/findings/1.0",
  "title": "oss-policy-kit normalized findings (findings/1.0)",
  "description": "Cross-scanner normalized + correlated finding artifact (ADR-030). Produced by `oss-policy-kit correlate-findings` as a read-only projection over scanner evidence already on disk. Single clone-only run: no persistence, no cross-run state. STRICT contract (additionalProperties:false everywhere); adding a field is a findings/1.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "generated_at",
    "kit_version",
    "target_path",
    "sources_read",
    "findings_total",
    "findings_by_severity",
    "findings",
    "correlation",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/findings/1.0"
    },
    "contract_version": { "const": "findings/1.0" },
    "generated_at": { "type": "string", "minLength": 1 },
    "kit_version": { "type": "string", "minLength": 1 },
    "target_path": { "type": "string" },
    "sources_read": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRecord" }
    },
    "findings_total": { "type": "integer", "minimum": 0 },
    "findings_by_severity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      },
      "required": ["critical", "high", "medium", "low", "info", "unknown"]
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "key_spec", "merged_groups", "cross_tool_merges"],
      "properties": {
        "strategy": { "const": "conservative-under-merge" },
        "key_spec": { "const": "opk-fk/v1" },
        "merged_groups": { "type": "integer", "minimum": 0 },
        "cross_tool_merges": { "type": "integer", "minimum": 0 }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "tool", "tool_version", "schema_version", "status"],
      "properties": {
        "path": { "type": "string" },
        "kind": { "enum": ["kit-evidence", "external-sarif", "enrichment-snapshot"] },
        "tool": { "type": "string" },
        "tool_version": { "type": ["string", "null"] },
        "schema_version": { "type": ["string", "null"] },
        "status": {
          "enum": ["ok", "not_available", "error", "timeout", "missing", "unreadable", "oversize"]
        }
      }
    },
    "severityPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "original"],
      "properties": {
        "tool": { "type": "string" },
        "original": { "type": "string" }
      }
    },
    "findingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "source_path", "rule", "severity_original", "message", "native_id"],
      "properties": {
        "tool": { "type": "string" },
        "source_path": { "type": "string" },
        "rule": { "type": "string" },
        "severity_original": { "type": "string" },
        "message": { "type": "string" },
        "native_id": { "type": ["string", "null"] }
      }
    },
    "logicalLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "resource_type", "resource_name", "kind", "namespace", "name"],
      "properties": {
        "type": { "type": ["string", "null"] },
        "resource_type": { "type": ["string", "null"] },
        "resource_name": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "namespace": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line_start", "line_end", "logical"],
      "properties": {
        "file": { "type": ["string", "null"] },
        "line_start": { "type": ["integer", "null"], "minimum": 1 },
        "line_end": { "type": ["integer", "null"], "minimum": 1 },
        "logical": { "$ref": "#/$defs/logicalLocation" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sources",
        "rule",
        "message",
        "cwe",
        "owasp",
        "severity",
        "location",
        "component",
        "vulnerability_ids",
        "epss",
        "kev",
        "cvss",
        "reachability",
        "waiver",
        "priority",
        "correlation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^opk-fk/v1:[0-9a-f]{16}$" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/findingSource" }
        },
        "rule": { "type": "string" },
        "message": { "type": "string" },
        "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } },
        "owasp": { "type": "array", "items": { "type": "string" } },
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normalized", "by_source"],
          "properties": {
            "normalized": { "enum": ["critical", "high", "medium", "low", "info", "unknown"] },
            "by_source": { "type": "array", "items": { "$ref": "#/$defs/severityPair" } }
          }
        },
        "location": { "$ref": "#/$defs/location" },
        "component": { "type": ["string", "null"] },
        "vulnerability_ids": { "type": "array", "items": { "type": "string" } },
        "epss": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "kev": { "type": ["boolean", "null"] },
        "cvss": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "reachability": { "enum": ["reachable", "not_reachable", "unknown", null] },
        "waiver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["waived", "matched_by", "waiver_owner", "expires_at"],
          "properties": {
            "waived": { "type": "boolean" },
            "matched_by": { "enum": ["vulnerability_id", "control_id", null] },
            "waiver_owner": { "type": ["string", "null"] },
            "expires_at": { "type": ["string", "null"] }
          }
        },
        "priority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rank", "rationale"],
          "properties": {
            "rank": { "type": "integer", "minimum": 1 },
            "rationale": { "type": "string" }
          }
        },
        "correlation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "merged_from", "confidence"],
          "properties": {
            "key": { "type": "string" },
            "merged_from": { "type": "integer", "minimum": 1 },
            "confidence": { "enum": ["exact"] }
          }
        }
      }
    }
  }
}
