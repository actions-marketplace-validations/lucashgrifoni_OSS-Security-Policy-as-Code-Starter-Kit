{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/reports/schema/evidence-aws-codecommit-review-posture.schema.json",
  "title": "AWS CodeCommit approval-rule review posture evidence",
  "type": "object",
  "required": ["schema_version", "attested_at", "attested_by", "repository", "posture"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "aws-codecommit-review/v1" },
    "attested_at": { "type": "string", "format": "date" },
    "attested_by": { "type": "string" },
    "repository": { "type": "string" },
    "posture": {
      "type": "object",
      "required": ["approval_rule_templates_enabled", "minimum_approvals_enforced"],
      "additionalProperties": false,
      "properties": {
        "approval_rule_templates_enabled": { "type": "boolean" },
        "minimum_approvals_enforced": { "type": "boolean" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_collection_method", "collected_at", "source_url"],
      "properties": {
        "evidence_collection_method": { "type": "string", "enum": ["live", "manual"] },
        "collected_at": { "type": "string" },
        "source_url": { "type": "string" },
        "mode": { "type": "string", "enum": ["api"] }
      }
    },
    "notes": { "type": "string" }
  }
}
