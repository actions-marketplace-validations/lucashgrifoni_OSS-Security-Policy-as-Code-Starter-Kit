{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/reports/schema/evidence-github-release-immutability.schema.json",
  "title": "GitHub release immutability evidence",
  "type": "object",
  "required": ["schema_version", "attested_at", "attested_by", "repository", "posture"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "github-release-immutability/v1" },
    "attested_at": { "type": "string", "format": "date" },
    "attested_by": { "type": "string" },
    "repository": { "type": "string" },
    "posture": {
      "type": "object",
      "required": ["immutable_releases_enabled", "release_attestation_present"],
      "additionalProperties": false,
      "properties": {
        "immutable_releases_enabled": { "type": "boolean" },
        "release_attestation_present": { "type": "boolean" },
        "attestation_subject_digest_recorded": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "verified_at", "transparency_log_inclusion"],
      "description": "Optional. Records that the release attestation was independently verified (in CI). Consumed by GH-IMMUTREL-070's ATTESTED upgrade (opt-in --enable-attested).",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["gh-attestation-verify", "cosign-verify-bundle", "cosign-verify-attestation", "in-toto-verify", "other"]
        },
        "verified_at": { "type": "string", "format": "date-time" },
        "transparency_log_inclusion": { "type": "boolean" },
        "issuer": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_collection_method", "collected_at", "source_url"],
      "properties": {
        "evidence_collection_method": { "type": "string", "enum": ["live", "manual"] },
        "collected_at": { "type": "string" },
        "source_url": { "type": "string" },
        "mode": { "type": "string", "enum": ["api"] }
      }
    },
    "notes": { "type": "string" }
  }
}
