{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/reports/schema/evidence-aws-codepipeline.schema.json",
  "title": "AWS CodePipeline promotion and artifact governance evidence",
  "type": "object",
  "required": ["schema_version", "attested_at", "attested_by", "pipeline", "posture"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "aws-codepipeline/v1" },
    "attested_at": { "type": "string", "format": "date" },
    "attested_by": { "type": "string" },
    "pipeline": { "type": "string" },
    "posture": {
      "type": "object",
      "required": [
        "manual_approval_before_production",
        "artifact_store_encryption_enabled",
        "production_execution_mode_not_parallel"
      ],
      "additionalProperties": false,
      "properties": {
        "manual_approval_before_production": { "type": "boolean" },
        "artifact_store_encryption_enabled": { "type": "boolean" },
        "production_execution_mode_not_parallel": { "type": "boolean" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_collection_method", "collected_at", "source_url"],
      "properties": {
        "evidence_collection_method": { "type": "string", "enum": ["live", "manual"] },
        "collected_at": { "type": "string" },
        "source_url": { "type": "string" },
        "mode": { "type": "string", "enum": ["api"] }
      }
    },
    "iam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_service_role_arn_configured"],
      "properties": {
        "pipeline_service_role_arn_configured": { "type": "boolean" }
      }
    },
    "notes": { "type": "string" }
  }
}
