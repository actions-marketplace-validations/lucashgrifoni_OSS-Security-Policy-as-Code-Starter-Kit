{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucashgrifoni/OSS-Security-Policy-as-Code-Starter-Kit/reports/schema/evaluation-result.schema.json",
  "title": "OSS Policy Kit evaluation report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "kit_version",
    "target_path",
    "profile_id",
    "profile_title",
    "summary_by_status",
    "results",
    "operational_warnings"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "kit_version": { "type": "string" },
    "target_path": { "type": "string" },
    "profile_id": { "type": "string" },
    "profile_title": { "type": "string" },
    "scorecard_path": { "type": ["string", "null"] },
    "scorecard_supplemental": {
      "type": ["object", "null"],
      "required": [
        "loaded",
        "path",
        "check_count",
        "influenced_control_ids",
        "workflows_satisfied_codeql_signal",
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "loaded": { "type": "boolean" },
        "path": { "type": ["string", "null"] },
        "check_count": { "type": "integer", "minimum": 0 },
        "influenced_control_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workflows_satisfied_codeql_signal": { "type": "boolean" },
        "explanation": { "type": "string" }
      }
    },
    "summary_by_status": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "operational_warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_result" }
    },
    "external_waiver_path": { "type": ["string", "null"] },
    "action_insights": {
      "type": "object",
      "required": [
        "top_structural_causes",
        "recommended_actions",
        "failing_controls_by_category"
      ],
      "additionalProperties": false,
      "properties": {
        "top_structural_causes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bucket", "count"],
            "additionalProperties": false,
            "properties": {
              "bucket": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "recommended_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "failing_controls_by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "live_collection": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["performed", "platform", "collected_at", "api_evidence_sources"],
          "additionalProperties": false,
          "properties": {
            "performed": { "type": "boolean" },
            "platform": { "type": ["string", "null"] },
            "collected_at": { "type": ["string", "null"] },
            "api_evidence_sources": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "weighted_score": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["earned", "possible", "percent"],
          "additionalProperties": false,
          "properties": {
            "earned": { "type": "integer", "minimum": 0 },
            "possible": { "type": "integer", "minimum": 0 },
            "percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      ]
    },
    "summary_by_gate_role": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "gate_execution_model": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "control_result": {
      "type": "object",
      "required": [
        "control_id",
        "title",
        "category",
        "status",
        "lifecycle",
        "profile",
        "evidence_sources",
        "confidence",
        "reason",
        "remediation"
      ],
      "properties": {
        "control_id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "lifecycle": {
          "type": "string",
          "enum": ["experimental", "stable", "deprecated"]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "manual-review-required",
            "self-attested",
            "not-evaluated",
            "not-observable",
            "not-applicable",
            "waived"
          ]
        },
        "profile": { "type": "string" },
        "evidence_sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "string" },
        "reason": { "type": "string" },
        "remediation": { "type": "string" },
        "owner": { "type": ["string", "null"] },
        "expires_at": { "type": ["string", "null"] },
        "waiver": {
          "type": ["object", "null"],
          "required": ["control_id", "justification", "owner", "status"],
          "properties": {
            "control_id": { "type": "string" },
            "justification": { "type": "string" },
            "owner": { "type": "string" },
            "status": { "type": "string" },
            "expires_at": { "type": ["string", "null"] },
            "applies_to": {
              "type": ["array", "null"],
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "extra": { "type": "object" },
        "evidence_collection_method": {
          "type": "string",
          "enum": ["live", "manual", "static"]
        },
        "assurance": {
          "type": "string",
          "enum": ["deterministic", "signal", "evidence-backed"]
        },
        "deprecation_note": { "type": "string" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "additionalProperties": false
    }
  }
}
